Table accounts [headercolor: #3D5FBF] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null, note: 'Business name used in the email footer']
  website varchar(255)
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2']
  address_line1 varchar(255) [not null]
  address_line2 varchar(255)
  city varchar(120) [not null]
  region varchar(120)
  postal_code varchar(20)
  timezone varchar(64) [not null, default: 'UTC', note: 'IANA timezone for scheduling and display (BR-07)']
  date_format varchar(20) [not null, default: 'DD/MM/YYYY']
  time_format varchar(5) [not null, default: '24h']
  logo_key varchar(512) [note: 'Object-storage key (PREF-08)']
  brand_color char(7)
  onboarding_completed_at timestamptz [note: 'Set when send-readiness checks first pass (ONB-07, ONB-09)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'One business using the platform. Every business-owned row carries account_id.'
}

Table custom_fields [headercolor: #0F8A83] {
  id uuid [pk, default: `gen_random_uuid()`]
