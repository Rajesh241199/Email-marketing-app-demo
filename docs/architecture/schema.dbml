  trigger_list_id uuid [ref: >? lists.id]
  trigger_tag_id uuid [ref: >? tags.id]
  sender_id uuid [ref: >? senders.id]
  allow_reentry boolean [not null, default: false, note: 'AUT-09']
  activated_at timestamptz
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, status) [name: 'ix_automations_account_id_status']
    trigger_list_id [name: 'ix_automations_active_trigger_list', note: 'WHERE status = \'active\' AND trigger_list_id IS NOT NULL']
    trigger_tag_id [name: 'ix_automations_active_trigger_tag', note: 'WHERE status = \'active\' AND trigger_tag_id IS NOT NULL']
  }

  Note: 'CHECK: ck_automations_trigger_target_matches_type: (trigger_type = \'list_joined\' AND trigger_list_id IS NOT NULL AND trigger_tag_id IS NULL) OR (trigger_type = \'tag_applied\' AND trigger_tag_id IS NOT NULL AND trigger_list_id IS NULL) | ck_automations_active_has_sender: status <> \'active\' OR sender_id IS NOT NULL'
}

