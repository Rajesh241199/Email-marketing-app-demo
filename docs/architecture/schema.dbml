  Indexes {
    (automation_id, position) [unique, name: 'uq_automation_steps_automation_id_position']
  }

  Note: 'CHECK: ck_automation_steps_step_fields_match_type: (step_type = \'wait\' AND wait_amount > 0 AND wait_unit IS NOT NULL AND template_id IS NULL AND content_json IS NULL) OR (step_type = \'email\' AND wait_amount IS NULL AND wait_unit IS NULL AND (template_id IS NOT NULL OR content_json IS NOT NULL))'
}

Table campaigns [headercolor: #C4405F] {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null, ref: > accounts.id]
  name varchar(200) [not null, note: 'Internal name (CMP-01)']
  status campaign_status [not null, default: 'draft']
  tier campaign_tier [not null, default: 'regular', note: 'Matched against subscribers.email_frequency (PREF-09)']
  topic_list_id uuid [ref: >? lists.id, note: 'Topic this campaign counts as for preference-center opt-outs. Applies even when the audience is a segment, tag, or individual subscriber, not just a list (schema-v1.md section 4)']
  sender_id uuid [ref: >? senders.id]
  template_id uuid [ref: >? templates.id, note: 'Template it started from; content is copied into this row']
  subject varchar(255)
  preheader varchar(255)
  content_json jsonb
  html text
  plain_text text
  scheduled_at timestamptz [note: 'UTC; entered in account timezone (CMP-09)']
  confirmed_by uuid [ref: >? users.id]
  confirmed_at timestamptz [note: 'Final pre-send confirmation (CMP-08)']
  audience_frozen_at timestamptz [note: 'campaign_recipients written; audience fixed']
  sending_started_at timestamptz [note: 'Content and audience immutable from here (BR-04)']
  completed_at timestamptz
  cancelled_at timestamptz
  eligible_count integer [note: 'Recipients with status pending/queued after freeze (CMP-05)']
  duplicated_from_id uuid [ref: >? campaigns.id]
  created_by uuid [ref: >? users.id]
  correlation_id uuid [note: 'Trace ID across API request, background job and provider events']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, created_at) [name: 'ix_campaigns_account_id_created_at']
    (account_id, status) [name: 'ix_campaigns_account_id_status']
    scheduled_at [name: 'ix_campaigns_due', note: 'WHERE status = \'scheduled\'']
    topic_list_id [name: 'ix_campaigns_topic_list_id', note: 'WHERE topic_list_id IS NOT NULL']
  }

  Note: 'One-to-many email send. Content is copied from the template at creation. CHECK: ck_campaigns_frozen_before_send: status NOT IN (\'sending\', \'sent\', \'partially_failed\', \'failed\') OR (audience_frozen_at IS NOT NULL AND sending_started_at IS NOT NULL) | ck_campaigns_scheduled_has_time: status <> \'scheduled\' OR scheduled_at IS NOT NULL | ck_campaigns_confirmed_before_send: status NOT IN (\'scheduled\', \'sending\', \'sent\', \'partially_failed\', \'failed\') OR (sender_id IS NOT NULL AND confirmed_at IS NOT NULL)'
}

Table automation_enrollments [headercolor: #4F8A25] {
  id uuid [pk, default: `gen_random_uuid()`]
  automation_id uuid [not null, ref: > automations.id]
  subscriber_id uuid [not null, ref: > subscribers.id]
  current_step_id uuid [ref: >? automation_steps.id]
  status enrollment_status [not null, default: 'active']
  next_run_at timestamptz [note: 'Worker picks up due steps']
  entered_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  exit_reason varchar(50) [note: 'e.g. unsubscribed, suppressed, automation_paused']

  Indexes {
    current_step_id [name: 'ix_automation_enrollments_current_step_id']
    next_run_at [name: 'ix_automation_enrollments_due', note: 'WHERE status = \'active\'']
    subscriber_id [name: 'ix_automation_enrollments_subscriber_id']
    (automation_id, subscriber_id) [unique, name: 'uq_automation_enrollments_automation_id_subscriber_id']
  }

  Note: 'A subscriber moving through an automation (AUT-08). CHECK: ck_automation_enrollments_active_has_next_run: status <> \'active\' OR next_run_at IS NOT NULL'
}

Table campaign_audiences [headercolor: #C4405F] {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  mode audience_mode [not null, default: 'include']
  list_id uuid [ref: >? lists.id]
  segment_id uuid [ref: >? segments.id]
  tag_id uuid [ref: >? tags.id]
  subscriber_id uuid [ref: >? subscribers.id]

  Indexes {
    campaign_id [name: 'ix_campaign_audiences_campaign_id']
    list_id [name: 'ix_campaign_audiences_list_id', note: 'WHERE list_id IS NOT NULL']
    segment_id [name: 'ix_campaign_audiences_segment_id', note: 'WHERE segment_id IS NOT NULL']
    subscriber_id [name: 'ix_campaign_audiences_subscriber_id', note: 'WHERE subscriber_id IS NOT NULL']
    tag_id [name: 'ix_campaign_audiences_tag_id', note: 'WHERE tag_id IS NOT NULL']
  }

  Note: 'Audience rule (CMP-04). Exactly one target column is set per row. CHECK: ck_campaign_audiences_exactly_one_target: num_nonnulls(list_id, segment_id, tag_id, subscriber_id) = 1'
}

Table campaign_links [headercolor: #C4405F] {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  url text [not null]
  label varchar(255)
  position integer

  Indexes {
    campaign_id [name: 'ix_campaign_links_campaign_id']
  }

  Note: 'Tracked link in sent content, for per-link click counts.'
}

Table campaign_stats [headercolor: #2A7DB5] {
  campaign_id uuid [pk, ref: - campaigns.id]
  recipients integer [not null, default: 0, note: 'Frozen, not skipped']
  skipped integer [not null, default: 0]
  sent integer [not null, default: 0, note: 'Accepted by the provider']
  delivered integer [not null, default: 0]
  hard_bounces integer [not null, default: 0]
  soft_bounces integer [not null, default: 0]
  complaints integer [not null, default: 0]
  unique_opens integer [not null, default: 0]
  unique_clicks integer [not null, default: 0]
  unsubscribes integer [not null, default: 0]
  failures integer [not null, default: 0, note: 'failed + rejected']
  last_event_id bigint [note: 'Highest email_events.id included']
  computed_at timestamptz [not null, default: `now()`]

  Note: 'DERIVED rollup of email_events / email_messages for reports and the dashboard.'
}

Table test_sends [headercolor: #C4405F] {
  id uuid [pk, default: `gen_random_uuid()`]
  campaign_id uuid [not null, ref: > campaigns.id]
  sent_by uuid [not null, ref: > users.id]
  to_emails "text[]" [not null]
  provider_message_id varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: 'ix_test_sends_campaign_id']
  }

  Note: 'Test emails sent before confirmation (CMP-07). Not counted in campaign stats.'
}

Table campaign_recipients [headercolor: #C4405F] {
  id bigint [pk, increment]
  campaign_id uuid [not null, ref: > campaigns.id]
  subscriber_id uuid [ref: >? subscribers.id, note: 'NULL only if the subscriber was deleted later']
  email citext [not null, note: 'Snapshot at freeze time']
  merge_data jsonb [note: 'Snapshot of personalization fields at freeze time']
  matched_audience_id uuid [ref: >? campaign_audiences.id, note: 'First include rule that selected this person']
  status recipient_status [not null, default: 'pending']
  skip_reason skip_reason
  frozen_at timestamptz [not null, default: `now()`]
  status_changed_at timestamptz

  Indexes {
    (campaign_id, status) [name: 'ix_campaign_recipients_campaign_id_status']
    subscriber_id [name: 'ix_campaign_recipients_subscriber_id']
    (campaign_id, email) [unique, name: 'uq_campaign_recipients_campaign_id_email']
  }

  Note: 'Frozen audience: one row per unique email, written when the campaign is confirmed. CHECK: ck_campaign_recipients_skip_reason_iff_skipped: (status = \'skipped\') = (skip_reason IS NOT NULL)'
}

Table email_messages [headercolor: #2A7DB5] {
  id bigint [pk, increment]
  account_id uuid [not null, ref: > accounts.id]
  subscriber_id uuid [ref: >? subscribers.id]
  email citext [not null, note: 'Recipient snapshot']
  campaign_id uuid [ref: >? campaigns.id]
  campaign_recipient_id bigint [ref: >? campaign_recipients.id]
  automation_id uuid [ref: >? automations.id]
  automation_step_id uuid [ref: >? automation_steps.id]
  enrollment_id uuid [ref: >? automation_enrollments.id]
  status message_status [not null, default: 'queued']
  provider email_provider [not null, default: 'ses']
  provider_message_id varchar(255) [note: 'Set when the provider accepts the message']
  attempt_count smallint [not null, default: 0, note: 'Bounded retries (CMP-14)']
  next_attempt_at timestamptz [note: 'Backoff for temporary provider failures']
  last_error text
  queued_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  delivered_at timestamptz
  bounced_at timestamptz
  complained_at timestamptz
  first_opened_at timestamptz
  first_clicked_at timestamptz
  unsubscribed_at timestamptz
  correlation_id uuid [note: 'Trace ID across API request, background job and provider events']

  Indexes {
    (account_id, queued_at) [name: 'ix_email_messages_account_id_queued_at']
    automation_id [name: 'ix_email_messages_automation_id', note: 'WHERE automation_id IS NOT NULL']
    automation_step_id [name: 'ix_email_messages_automation_step_id', note: 'WHERE automation_step_id IS NOT NULL']
    (campaign_id, status) [name: 'ix_email_messages_campaign_id_status']
    queued_at [name: 'ix_email_messages_pending', note: 'WHERE status IN (\'queued\', \'submitting\')']
    subscriber_id [name: 'ix_email_messages_subscriber_id']
    campaign_recipient_id [unique, name: 'uq_email_messages_campaign_recipient_id', note: 'WHERE campaign_recipient_id IS NOT NULL']
    (enrollment_id, automation_step_id) [unique, name: 'uq_email_messages_enrollment_id_step_id', note: 'WHERE enrollment_id IS NOT NULL']
    (provider, provider_message_id) [unique, name: 'uq_email_messages_provider_message_id', note: 'WHERE provider_message_id IS NOT NULL']
  }

  Note: 'One email to one recipient, from a campaign (via campaign_recipients) or an automation. CHECK: ck_email_messages_one_origin: (campaign_id IS NOT NULL AND campaign_recipient_id IS NOT NULL AND automation_id IS NULL) OR (automation_id IS NOT NULL AND campaign_id IS NULL AND campaign_recipient_id IS NULL) | ck_email_messages_delivered_has_timestamp: status <> \'delivered\' OR delivered_at IS NOT NULL | ck_email_messages_accepted_has_provider_id: status NOT IN (\'accepted\', \'delivered\', \'soft_bounced\', \'bounced\', \'complained\', \'rejected\') OR (provider_message_id IS NOT NULL AND accepted_at IS NOT NULL)'
}

Table email_events [headercolor: #2A7DB5] {
  id bigint [pk, increment]
  account_id uuid [not null, ref: > accounts.id]
  message_id bigint [ref: >? email_messages.id, note: 'NULL only if the provider reports an unknown message']
  campaign_id uuid [ref: >? campaigns.id, note: 'Copied from the message so campaign reports avoid a join']
  provider email_provider [not null]
  provider_event_id varchar(255) [not null, note: 'Provider\'s event ID; dedupes webhook redeliveries']
  event_type email_event_type [not null]
  bounce_type bounce_type
  link_id uuid [ref: >? campaign_links.id]
  occurred_at timestamptz [not null]
  received_at timestamptz [not null, default: `now()`]
  payload jsonb
  correlation_id uuid [note: 'Trace ID across API request, background job and provider events']

  Indexes {
    (account_id, event_type, occurred_at) [name: 'ix_email_events_account_id_event_type_occurred_at']
    (campaign_id, event_type) [name: 'ix_email_events_campaign_id_event_type']
    link_id [name: 'ix_email_events_link_id', note: 'WHERE link_id IS NOT NULL']
    message_id [name: 'ix_email_events_message_id']
    (provider, provider_event_id) [unique, name: 'uq_email_events_provider_event_id']
  }

  Note: 'Append-only provider and tracking events. The source of truth for delivery analytics. CHECK: ck_email_events_link_only_on_click: event_type = \'click\' OR link_id IS NULL | ck_email_events_bounce_type_only_on_bounce: event_type = \'bounce\' OR bounce_type IS NULL'
}

Table subscription_events [headercolor: #C2410C] {
  id bigint [pk, increment]
  account_id uuid [not null, ref: > accounts.id]
  subscriber_id uuid [ref: >? subscribers.id]
  email citext [not null, note: 'Snapshot, kept if subscriber is deleted']
  event_type subscription_event_type [not null]
  list_id uuid [ref: >? lists.id]
  source change_source [not null]
  campaign_id uuid [ref: >? campaigns.id]
  message_id bigint [ref: >? email_messages.id]
  ip_address inet
  user_agent text
  details jsonb
  occurred_at timestamptz [not null, default: `now()`]
  correlation_id uuid [note: 'Trace ID across API request, background job and provider events']

  Indexes {
    (account_id, occurred_at) [name: 'ix_subscription_events_account_id_occurred_at']
    campaign_id [name: 'ix_subscription_events_campaign_id', note: 'WHERE campaign_id IS NOT NULL']
    list_id [name: 'ix_subscription_events_list_id', note: 'WHERE list_id IS NOT NULL']
    message_id [name: 'ix_subscription_events_message_id', note: 'WHERE message_id IS NOT NULL']
    (subscriber_id, occurred_at) [name: 'ix_subscription_events_subscriber_id_occurred_at']
  }
}

Table suppressions [headercolor: #C2410C] {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null, ref: > accounts.id]
  email citext [not null]
  reason suppression_reason [not null]
  source change_source [not null]
  email_event_id bigint [ref: >? email_events.id, note: 'Bounce / complaint event that caused it']
  created_by uuid [ref: >? users.id]
  lifted_at timestamptz [note: 'Only via explicit re-subscription (CMPY-03)']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, email) [name: 'ix_suppressions_account_id_email']
    email_event_id [name: 'ix_suppressions_email_event_id', note: 'WHERE email_event_id IS NOT NULL']
    (account_id, email) [unique, name: 'uq_suppressions_active_email', note: 'WHERE lifted_at IS NULL']
  }
}

TableGroup account_and_auth {
  accounts
  sending_domains
  users
  auth_tokens
  senders
  user_identities
  user_sessions
}

TableGroup audience {
  custom_fields
  lists
  subscribers
  tags
  list_memberships
  segments
  subscriber_field_values
  subscriber_tags
}

TableGroup templates_content {
  content_blocks
  media_assets
  templates
}

TableGroup csv_import {
  import_jobs
  import_column_mappings
  import_row_errors
}

TableGroup automation {
  automations
  automation_steps
  automation_enrollments
}

TableGroup campaign_management {
  campaigns
  campaign_audiences
  campaign_links
  test_sends
  campaign_recipients
}

TableGroup delivery_and_analytics {
  campaign_stats
  email_messages
  email_events
}

TableGroup consent_and_suppression {
  subscription_events
  suppressions
}

