ENV=development

# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_marketing
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_marketing_test

JWT_SECRET=change-me-to-a-random-64-char-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local disk path used by app/core/storage.py in development. Swap for an S3-backed
# implementation of the same interface in production.
UPLOAD_DIR=var/uploads
